# The SHAPE of the app's secrets. Never put real values in this file.
#
# Streamlit Community Cloud: paste the filled-in copy into the app's
#   Settings > Secrets (or "Advanced settings" when deploying).
# Local live run: copy to .streamlit/secrets.toml (git-ignored) and run from the repo root:
#   streamlit run app/streamlit_app.py
# Steps and the key-pair commands: deploy/RUNBOOK.md

[connections.snowflake]
account = "<orgname-accountname>"        # the account identifier, from secrets only
user = "FORGE_APP_SVC"                   # TYPE = SERVICE user, key-pair auth only
role = "FORGE_APP_ROLE"                  # read-only app role (sql/05_app_access/)
warehouse = "FORGE_WH"
database = "SUPPLY_CHAIN_FORGE"
# The unencrypted PKCS#8 private key (rsa_key.p8), header and footer lines included.
private_key = """
<paste the whole private key here>
"""

[forge]
# mode = "mock"          # optional: force practice data without a commit ("live" is the default here)
# shortcut = false       # optional: turn off instant answers (every Ask question goes to the agent)
# stream = false         # optional: don't stream agent answers (CR-008); use DATA_AGENT_RUN only
# Ask limits (defaults in app/utils/config.py ASK_LIMITS); uncomment to change them.
# cooldown_seconds = 10  # per visitor, between two agent calls
# per_session = 10       # per visitor session
# concurrent = 3         # all visitors, agent calls running at once
# per_hour = 30          # all visitors, rolling hour
# per_day = 200          # all visitors, per UTC day
